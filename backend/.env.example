# এই ফাইলটি .env নামে কপি করে নিজের API key বসান
ANTHROPIC_API_KEY=your_api_key_here

# /api/admin/* বাল্ক-ইম্পোর্ট এন্ডপয়েন্ট সুরক্ষিত রাখার জন্য - নিজের একটা
# র‍্যান্ডম স্ট্রিং বসান, রিকোয়েস্টে X-Admin-Key হেডারে এটা পাঠাতে হবে
ADMIN_API_KEY=your_admin_secret_here

# ---------- পেমেন্ট ----------
# ব্রাউজার থেকে পৌঁছানো যায় এমন ব্যাকএন্ড URL (bKash callback-এর জন্য) — শুধু প্রোডাকশনে দিন।
# না দিলে রিকোয়েস্টের host ব্যবহার হয় (emulator থেকে 10.0.2.2:8000, ডেস্কটপ থেকে localhost:8000)
# PUBLIC_BASE_URL=https://api.example.com
# শুধু ডেভেলপমেন্টে true করুন — আসল টাকা ছাড়া পেমেন্ট ফ্লো টেস্ট করার জন্য। প্রোডাকশনে কখনো নয়!
PAYMENT_MOCK_ENABLED=false  # bKash/Nagad credential না থাকলে ডেভেলপমেন্টে true দিন
# bKash Tokenized Checkout (মার্চেন্ট অ্যাকাউন্ট থেকে পাবেন)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
